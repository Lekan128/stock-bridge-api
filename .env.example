# Copy to .env (or set these as real env vars / secrets in your hosting
# platform) and fill in real values for production. Never commit the
# filled-in file — .env is gitignored.
#
# See ../ENVIRONMENT.md for what each variable does, whether it's required,
# and what happens if it's missing.

# Activates src/main/resources/application-prod.yml
SPRING_PROFILES_ACTIVE=prod

# --- Database (application-prod.yml) ---
POSTGRES_HOST=your-prod-db-host
POSTGRES_PORT=5432
POSTGRES_DB=stock_bridge
POSTGRES_USER=stock_bridge_user
POSTGRES_PASSWORD=changeme

# --- JWT (application.yml) ---
# Required, no default in prod. Must be a strong random secret, >=32 bytes
# (HS256 minimum) - e.g. `openssl rand -base64 48`.
JWT_SECRET=changeme-generate-a-strong-random-secret
# Optional, defaults shown (15 minutes / 7 days, in milliseconds).
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# --- CORS (application-prod.yml) ---
# Required in prod, no default/wildcard fallback. Comma-separated if there's
# more than one origin (e.g. staging + prod frontend URLs).
# REPLACE with the actual deployed frontend URL - the value below is a
# placeholder only, and requests from it will not actually be allowed.
FRONTEND_ORIGIN=https://REPLACE-WITH-ACTUAL-DEPLOYED-FRONTEND-URL.example.com

# --- Super admin bootstrap (application.yml) ---
# Optional, and there is NO default outside local/docker: leave either of these
# blank and no super admin is created at all. That is the safe direction - the
# alternative, which this project used to ship, was a default password that is
# public in this repository silently becoming a production login.
# The bootstrap runs at most once; change the password immediately after first
# login, after which these two can be removed entirely.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme

# --- Platform owner bootstrap (application.yml) ---
# Creates ProcurePal's own tenant - the one client with is_platform_owner=TRUE
# that sells to everybody else - plus its Head Office branch and its root OWNER
# user. Without it a fresh production database has no seller and the marketplace
# is inert. Locally this comes from db/seed instead, which never runs in prod.
#
# ONLY THESE TWO SWITCH IT ON, and neither has a default in any profile. Leave
# them blank and the runner is never even instantiated.
PLATFORM_OWNER_ADMIN_EMAIL=ops@your-domain.example.com
PLATFORM_OWNER_ADMIN_PASSWORD=changeme
# Optional, defaults shown. PLATFORM_OWNER_ADMIN_USERNAME defaults to the admin
# email above; set it if you want a short login name instead.
PLATFORM_OWNER_NAME=ProcurePal
PLATFORM_OWNER_SLUG=procurepal
PLATFORM_OWNER_ADMIN_USERNAME=admin
PLATFORM_OWNER_PHONE=
# PREPAID or PAY_ON_DELIVERY_ALLOWED.
PLATFORM_OWNER_PAYMENT_TERMS=PREPAID

# --- AWS S3 (product image uploads, application.yml) ---
# Optional: if bucket/credentials are left blank, S3 upload is treated as
# unavailable and the app degrades gracefully instead of failing to start.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Namespaces everything this environment writes, so local and staging can share
# one bucket. Keep it 'local' here - the staging deploy sets 'staging', and its
# access key is scoped to that prefix, so neither can write over the other.
AWS_S3_KEY_PREFIX=local
# Optional. Blank = the access key above is used against S3 directly. Set = that
# key is only good for sts:AssumeRole and the ROLE carries the S3 permissions,
# which is the preferred shape - see stock-bridge-api/DEPLOYMENT.md.
AWS_ROLE_ARN=
# Names the session in CloudTrail. Ignored when AWS_ROLE_ARN is blank.
AWS_ROLE_SESSION_NAME=stock-bridge-api-local

# --- Transactional email / Amazon SES (application.yml) ---
# Optional: if EMAIL_FROM_ADDRESS is left blank the app still starts, and every
# outgoing email is logged and dropped instead of sent. Nothing else changes -
# orders, payments and signups all work, they just do not notify by email.
#
# SES uses the AWS credentials above (the same IAM user, or the same assumed
# role), so there is no second access key to manage here. Whichever principal
# they resolve to needs ses:SendEmail - see stock-bridge-api/DEPLOYMENT.md.
#
# The deliberate off switch, distinct from "not configured": set false on a
# deploy that HAS working SES credentials but must not send, such as staging
# running against a restored copy of the production database.
EMAIL_ENABLED=true
# Blank = use AWS_REGION. Set only if SES runs in a different region to the
# bucket, or if the bucket's region has no SES endpoint.
EMAIL_REGION=
# REQUIRED for email to work, and no default: this address (or its domain) must
# be a verified identity in the SES account, and SES rejects a send from
# anything else. Leave blank locally - mail is logged instead.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ProcurePal
# Optional. Where a customer's reply goes, when from-address is a no-reply.
EMAIL_REPLY_TO_ADDRESS=
# Optional but strongly recommended in production: an SES configuration set is
# how bounces and complaints get tracked, and an unmonitored bounce rate is what
# gets a sending domain suspended by AWS.
EMAIL_CONFIGURATION_SET=
# The FRONTEND's public URL - every link in every email is an in-app route, not
# an API one. Must match FRONTEND_ORIGIN's host in a real deployment. Blank
# degrades to emails with no links rather than links that 404.
EMAIL_APP_BASE_URL=http://localhost:5173
# Optional shared ops inbox, copied on operator-facing mail (new orders, payments
# received). Blank means that mail goes to the platform owner tenant's own admin
# contact email, which always exists.
# SES's own IAM role, separate from AWS_ROLE_ARN (which is S3's), assumed from
# the SAME access key above - only the role differs, so there is still one
# long-lived secret to rotate. Optional: blank means SES borrows whatever
# credentials S3 uses, which requires ses:SendEmail on the S3 role.
# Prefer a separate role - see stock-bridge-api/DEPLOYMENT.md.
EMAIL_ROLE_ARN=
# Names the assumed SES session in CloudTrail. Ignored when EMAIL_ROLE_ARN is blank.
EMAIL_ROLE_SESSION_NAME=stock-bridge-api-ses-local
EMAIL_OPERATOR_ADDRESS=
# Where new vendor waitlist applications are announced. Unlike every other
# address here this one DEFAULTS to support@procurepaddy.com rather than to
# blank - a blank ops inbox sends fine and reaches nobody, so applications would
# pile up unread while every applicant has already been told we are reviewing
# them. Blank here means "use that default"; set it to redirect them. In the SES
# sandbox the address must be verified or these sends fail.
EMAIL_VENDOR_WAITLIST_ADDRESS=
# How many vendor waitlist applications one caller may submit per rolling window.
# Keyed on both the source address and the submitted email - the endpoint is
# public, so it has no principal to key on. Blank/absent uses the defaults (3, 1h).
VENDOR_WAITLIST_SUBMIT_LIMIT=3
VENDOR_WAITLIST_SUBMIT_WINDOW=1h

# --- One-click unsubscribe / RFC 8058 (application.yml) ---
# Both blank locally: application-local.yml carries dev-only placeholders, so
# unsubscribe links work out of the box in local dev without setting anything.
#
# In a real deployment these are the ONLY two things gating promotional email,
# and unlike everything else in this file they are fail-closed: with either one
# blank, PROMOTIONAL email is dropped rather than sent without a working
# List-Unsubscribe header. Transactional, verification and security mail are
# unaffected. Nothing in the app sends promotional mail yet.
#
# The signing key. Generate once with `openssl rand -base64 48`, keep it
# identical across every instance, and treat it as PERMANENT - rotating it
# invalidates every unsubscribe link ever mailed, and a dead unsubscribe link is
# how a reader is taught to press "report spam" instead. Deliberately NOT
# JWT_SECRET: that one is rotated routinely, and sharing them would couple a
# cheap rotation to an expensive one. See DEPLOYMENT.md.
EMAIL_UNSUBSCRIBE_SECRET=
# The public origin of THIS API - the one URL in the email config that is not a
# frontend route, because mail providers POST it from their own servers with no
# browser involved. Contrast EMAIL_APP_BASE_URL above.
EMAIL_UNSUBSCRIBE_API_BASE_URL=

# --- Email address verification (application.yml) ---
# All three are OPTIONAL with working defaults; a local setup needs none of them.
# What this feature actually depends on is EMAIL_APP_BASE_URL above, because the
# confirmation link is a frontend route (/verify-email?token=...). Leave that
# blank and no link can be built - which means no user created after
# V8__email_eligibility.sql can ever become verified, and an unverified address
# receives NO transactional mail at all. See ENVIRONMENT.md.
#
# How long an emailed confirmation link stays redeemable. Do not raise beyond a
# few days: past that the address a token was bound to has drifted from the
# address on the account, and the binding check refuses more links than the
# expiry does.
EMAIL_VERIFICATION_TOKEN_TTL=24h
# How many confirmation emails one account may request per window through
# POST /api/me/email-verification. This is the only bound on an endpoint that
# makes the server send mail to a caller-chosen address. In-process, so
# per-instance - see EmailVerificationRateLimiter.
EMAIL_VERIFICATION_RESEND_LIMIT=3
EMAIL_VERIFICATION_RESEND_WINDOW=1h

# --- SES bounce & complaint handling via SNS (application.yml) ---
# The reactive half of email eligibility: AWS telling us an address is dead or
# that its owner reported us as spam. Locally there is no SNS topic and nothing
# arrives, so all of this is inert - it is here so the names are discoverable.
# Setup for a deployed environment is in stock-bridge-api/DEPLOYMENT.md.
#
# LEAVE THIS TRUE. Unlike MONNIFY_REQUIRE_WEBHOOK_SIGNATURE below, relaxing it
# has NO safety net: there is no "ask SES again whether that bounced" API, so
# the notification body IS the evidence and a forged one is acted on directly.
# False turns POST /api/webhooks/ses/notifications into a public API for
# unverifying every customer on the platform.
SES_SNS_REQUIRE_SIGNATURE=true
# The SNS topic ARN this endpoint accepts notifications from. Blank accepts ANY
# topic, which is a real weakness: a valid AWS signature only proves that SOME
# SNS topic sent the message, and anybody with an AWS account can point their
# own topic here. Set it in every deployed environment.
SES_SNS_TOPIC_ARN=
# Narrows the SSRF allow-list on SigningCertURL/SubscribeURL from any
# sns.<region>.amazonaws.com host to exactly one. The allow-list is enforced
# either way - see SnsEndpointGuard, which has no bypass flag.
SES_SNS_REGION=
# Whether a spam complaint stops ALL mail or only marketing. True (all mail) is
# the safer-for-reputation default and what AWS asks for; a complaint is scored
# against a sending domain every tenant shares. See ENVIRONMENT.md for the
# argument on both sides before changing it.
SES_SNS_COMPLAINTS_SUPPRESS_ALL_MAIL=true
# Whether a SubscriptionConfirmation is confirmed automatically by fetching its
# SubscribeURL (host-validated first). The alternative is pasting a URL out of a
# log within the one hour AWS allows before the token expires.
SES_SNS_CONFIRM_SUBSCRIPTIONS=true
SES_SNS_CONNECT_TIMEOUT=5s
SES_SNS_READ_TIMEOUT=10s

# --- Monnify payments (application.yml) ---
# SANDBOX/TEST credentials. Optional: if left blank the app still starts, card
# checkout returns a clean 503, and pay-on-delivery keeps working.
# Get production values from the Monnify dashboard; never commit real ones.
MONNIFY_API_KEY=MK_TEST_GC3B8XG2XX
MONNIFY_SECRET_KEY=A663NRZA544DDPEM7KDN7Z8HRV6YXD8S
MONNIFY_CONTRACT_CODE=5867418298
# Sandbox. Production is https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Where Monnify returns the buyer after checkout. Must be a route the frontend
# serves, and must match FRONTEND_ORIGIN's host.
MONNIFY_REDIRECT_URL=http://localhost:5173/checkout/return
# LEAVE THIS TRUE IN PRODUCTION. Monnify only sends the monnify-signature header
# on production webhooks - sandbox notifications carry no signature at all - so
# set it to false ONLY to exercise webhooks against sandbox.
MONNIFY_REQUIRE_WEBHOOK_SIGNATURE=true

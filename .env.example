# Copy to .env (or set these as real env vars / secrets in your hosting
# platform) and fill in real values for production. Never commit the
# filled-in file — .env is gitignored.
#
# See ../ENVIRONMENT.md for what each variable does, whether it's required,
# and what happens if it's missing.

# Activates src/main/resources/application-prod.yml
SPRING_PROFILES_ACTIVE=prod

# --- Database (application-prod.yml) ---
POSTGRES_HOST=your-prod-db-host
POSTGRES_PORT=5432
POSTGRES_DB=stock_bridge
POSTGRES_USER=stock_bridge_user
POSTGRES_PASSWORD=changeme

# --- JWT (application.yml) ---
# Required, no default in prod. Must be a strong random secret, >=32 bytes
# (HS256 minimum) - e.g. `openssl rand -base64 48`.
JWT_SECRET=changeme-generate-a-strong-random-secret
# Optional, defaults shown (15 minutes / 7 days, in milliseconds).
JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# --- CORS (application-prod.yml) ---
# Required in prod, no default/wildcard fallback. Comma-separated if there's
# more than one origin (e.g. staging + prod frontend URLs).
# REPLACE with the actual deployed frontend URL - the value below is a
# placeholder only, and requests from it will not actually be allowed.
FRONTEND_ORIGIN=https://REPLACE-WITH-ACTUAL-DEPLOYED-FRONTEND-URL.example.com

# --- Super admin bootstrap (application.yml) ---
# Optional: the bootstrap only runs once, and only if both are set. Change
# the password immediately after first login.
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=changeme

# --- AWS S3 (product image uploads, application.yml) ---
# Optional: if bucket/credentials are left blank, S3 upload is treated as
# unavailable and the app degrades gracefully instead of failing to start.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Monnify payments (application.yml) ---
# SANDBOX/TEST credentials. Optional: if left blank the app still starts, card
# checkout returns a clean 503, and pay-on-delivery keeps working.
# Get production values from the Monnify dashboard; never commit real ones.
MONNIFY_API_KEY=MK_TEST_GC3B8XG2XX
MONNIFY_SECRET_KEY=A663NRZA544DDPEM7KDN7Z8HRV6YXD8S
MONNIFY_CONTRACT_CODE=5867418298
# Sandbox. Production is https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Where Monnify returns the buyer after checkout. Must be a route the frontend
# serves, and must match FRONTEND_ORIGIN's host.
MONNIFY_REDIRECT_URL=http://localhost:5173/checkout/return
# LEAVE THIS TRUE IN PRODUCTION. Monnify only sends the monnify-signature header
# on production webhooks - sandbox notifications carry no signature at all - so
# set it to false ONLY to exercise webhooks against sandbox.
MONNIFY_REQUIRE_WEBHOOK_SIGNATURE=true
